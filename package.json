{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:world": "esbuild scripts/world-check.ts --bundle --platform=node --format=cjs --outfile=.check/world.cjs --log-level=error && node .check/world.cjs",
    "check:inv": "esbuild scripts/invtest.ts --bundle --platform=node --format=cjs --outfile=.check/invtest.cjs --log-level=error && node .check/invtest.cjs",
    "check:beach": "esbuild scripts/beachtest.ts --bundle --platform=node --format=cjs --outfile=.check/beachtest.cjs --log-level=error && node .check/beachtest.cjs",
    "check:admin": "node scripts/admincheck.cjs",
    "check:all": "npm run check:world && npm run check:inv && npm run check:beach && npm run check:svc && npm run check:admin",
    "check:svc": "esbuild scripts/svctest.ts --bundle --platform=node --format=cjs --outfile=.check/svctest.cjs --log-level=error && node .check/svctest.cjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
